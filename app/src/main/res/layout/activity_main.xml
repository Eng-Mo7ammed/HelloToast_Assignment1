
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/button_toast"
        android:layout_width="72dp"
        android:layout_height="50dp"
        android:layout_marginStart="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="@string/toast"
        android:textSize="12sp"
        android:backgroundTint="#3F51B5"
        android:onClick="show_toast"
        app:cornerRadius="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/text_display_count" />

    <Button
        android:id="@+id/button_zero"
        android:layout_width="72dp"
        android:layout_height="50dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="@string/zero"
        android:textSize="12sp"
        android:backgroundTint="@color/zero_inactive"
        android:onClick="show_zero"
        app:cornerRadius="0dp"
        app:layout_constraintStart_toStartOf="@id/button_toast"
        app:layout_constraintTop_toTopOf="@id/text_display_count"
        app:layout_constraintBottom_toBottomOf="@id/text_display_count" />

    <Button
        android:id="@+id/button_count"
        android:layout_width="72dp"
        android:layout_height="50dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="@string/count"
        android:textSize="12sp"
        android:backgroundTint="@color/count_even"
        android:onClick="increase_count"
        app:cornerRadius="0dp"
        app:layout_constraintStart_toStartOf="@id/button_toast"
        app:layout_constraintBottom_toBottomOf="@id/text_display_count" />

    <TextView
        android:id="@+id/text_display_count"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:background="#FFEB3B"
        android:gravity="center"
        android:text="@string/count_value"
        android:textColor="#3F51B5"
        android:textSize="150sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/button_toast"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
